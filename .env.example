# Example cross-platform configuration for Python scripts (macOS / Linux / Windows)
# Copy this file to `.env` in the repository root and fill in your Jellyfin server details.
# `.env` is gitignored so your network details and API keys stay private.

ANDROID_HOST_IP=192.168.1.100
ANDROID_SSH_USER=u0_a300
ANDROID_SSH_PORT=8022
REMOTE_MEDIA_ROOT=media
JELLYFIN_PORT=8096
JELLYFIN_API_KEY=
WEBDAV_LOCAL_PORT=8081
